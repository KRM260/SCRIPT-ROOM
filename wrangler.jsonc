{
  // Cloudflare Workers settings for Script Room.
  "name": "script-room",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Share links and Write together: the KV namespace that stores shared projects.
  // To use your own, create one in Cloudflare (Storage & databases > KV) and put its ID here.
  // Free image generation (Workers AI, Flux-1 Schnell). Remove these two lines to switch it off.
  "ai": { "binding": "AI" },
  "kv_namespaces": [
    { "binding": "SHARES", "id": "85be47de5e104fd9b566690c37bbb90e" }
  ]
}
